---
import Layout from '../layouts/Layout.astro';

const operationalSections = [
	{
		title: 'Naloge in poslanstvo',
		content:
			'Operativa PGD Tolmin je jedro naše gasilske dejavnosti. Sestavljajo jo usposobljeni gasilci, ki so pripravljeni na intervencije 24 ur na dan, 365 dni v letu. Naše področje delovanja obsega občino Tolmin, kjer nudimo pomoč pri požarih, prometnih nesrečah, poplavah in drugih nesrečah.',
	},
	{
		title: 'Usposabljanja in vaje',
		content:
			'Redno usposabljanje je temelj naše operativne pripravljenosti. Vsaka 2 tedna izvajamo vaje operative, kjer urimo gašenje, reševanje iz vozil, tehnično reševanje in delo z opremo. Naši gasilci se udeležujejo tudi tečajev in tekmovanj na regijskem in državnem nivoju.',
	},
	{
		title: 'Intervencije',
		content:
			'Letno izvedemo več kot 180 intervencij različnih vrst. Med najpogostejše sodijo tehnična reševanja pri prometnih nesrečah ter gašenje požarov na prostem in v objektih.',
	},
];

const operationalStats = [
	{ value: '45', label: 'Operativnih gasilcev' },
	{ value: '180+', label: 'Intervencij letno' },
	{ value: '24/7', label: 'Pripravljenost' },
];
---

<Layout
	title="Društvo | PGD Tolmin"
	description="O društvu, vodstvo, operativa in članstvo PGD Tolmin."
>
	<!-- Hero -->
	<div class="relative bg-stone-900 overflow-hidden">
		<div class="absolute inset-0 pointer-events-none">
			<div
				class="absolute -top-20 -right-20 w-96 h-96 bg-red-600/20 rounded-full blur-3xl"
			>
			</div>
			<div
				class="absolute bottom-0 left-0 w-full h-px bg-linear-to-r from-transparent via-red-600 to-transparent"
			>
			</div>
		</div>

		<div class="max-w-7xl mx-auto px-6 py-20 relative">
			<p
				class="text-red-500 text-xs font-bold tracking-[0.25em] uppercase mb-3"
			>
				PGD Tolmin
			</p>
			<h1
				class="text-5xl md:text-7xl font-black text-white leading-none tracking-tight"
			>
				O društvu
			</h1>
			<!-- <p
				class="mt-6 max-w-2xl text-stone-300 text-base md:text-lg leading-relaxed"
			>
				Prostovoljno gasilsko društvo Tolmin – zgodovina, poslanstvo in
				organizacija. Tukaj predstavljamo, kdo smo in kako delujemo za varnost
				skupnosti.
			</p> -->
		</div>
	</div>

	<div class="bg-stone-100">
		<div class="max-w-7xl mx-auto px-6 py-16 space-y-12">
			<section
				class="rounded-2xl bg-stone-50 border border-stone-200 p-8 shadow-sm"
			>
				<div class="md:flex md:gap-8">
					<div class="md:flex-1">
						<h2 class="text-2xl font-black text-stone-900 mb-3">Naše delo</h2>
						<p class="text-stone-600 leading-relaxed">
							PGD Tolmin deluje od leta <strong>1881</strong>. Smo prostovoljna
							organizacija, ki skrbi za varnost prebivalcev Tolmina in okolice.
							Naše delo vključuje gašenje, tehnične intervencije in reševanje ob
							naravnih nesrečah.
						</p>
					</div>

					<div class="md:w-64 mt-6 md:mt-0">
						<div
							class="rounded-lg bg-white p-4 border border-stone-200 text-center"
						>
							<p
								class="text-stone-400 text-xs uppercase tracking-wide font-bold"
							>
								Ustanovitev
							</p>
							<p class="mt-2 text-2xl font-black text-stone-900">1881</p>
						</div>
					</div>
				</div>
			</section>

			<section
				class="rounded-2xl border border-red-200 bg-red-50 p-8 shadow-sm"
			>
				<p class="text-xs font-bold uppercase tracking-[0.2em] text-red-600">
					Naša enota
				</p>
				<div class="mt-4 grid gap-4 sm:grid-cols-2">
					<div class="rounded-xl border border-red-200 bg-white p-5">
						<p class="text-3xl font-black text-stone-900">4.</p>
						<p class="mt-1 font-bold text-stone-900">
							kategorija gasilskega društva
						</p>
					</div>
					<div class="rounded-xl border border-red-200 bg-white p-5">
						<p class="text-3xl font-black text-red-600">GEŠP</p>
						<p class="mt-1 font-bold text-stone-900">
							gasilska enota širšega pomena
						</p>
					</div>
				</div>
			</section>

			<!-- Leadership / Team (polished) -->
			<section
				class="rounded-2xl bg-stone-50 border border-stone-200 p-8 shadow-sm"
			>
				<h2 class="text-2xl font-black text-stone-900 mb-6">Vodstvo</h2>
				<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="p-4 bg-white rounded-lg border border-stone-200">
						<p class="font-black text-stone-900">Jure Beguš</p>
						<p class="text-sm text-stone-600">Poveljnik</p>
					</div>

					<div class="p-4 bg-white rounded-lg border border-stone-200">
						<p class="font-black text-stone-900">David Rejc</p>
						<p class="text-sm text-stone-600">Predsednik</p>
					</div>
				</div>
			</section>

			<section
				id="operativa"
				class="rounded-2xl bg-stone-50 border border-stone-200 p-8 shadow-sm scroll-mt-24"
			>
				<div
					class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between"
				>
					<div>
						<h2 class="text-2xl font-black text-stone-900">Operativa</h2>
						<p class="mt-2 max-w-2xl text-stone-600 leading-relaxed">
							Naša operativna enota je pripravljena pomagati ob požarih,
							nesrečah in drugih izrednih dogodkih.
						</p>
					</div>
					<div class="flex flex-wrap gap-6">
						{
							operationalStats.map((stat) => (
								<div>
									<p class="text-2xl font-black text-stone-900">{stat.value}</p>
									<p class="mt-0.5 text-xs tracking-wide text-stone-500">
										{stat.label}
									</p>
								</div>
							))
						}
					</div>
				</div>

				<div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
					{
						operationalSections.map((section) => (
							<div>
								<h3 class="mb-2 text-lg font-black text-stone-900">
									{section.title}
								</h3>
								<p class="text-stone-600 leading-relaxed">{section.content}</p>
							</div>
						))
					}
				</div>
			</section>
		</div>
	</div>

	<style>
		.section-card {
			opacity: 0;
			transform: translateY(20px);
			animation: fadeUp 0.5s ease-out forwards;
		}

		/* leader-card hover and avatar removed per user request */

		@keyframes fadeUp {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}
	</style>
</Layout>
